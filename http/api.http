@host = http://localhost:3000
@token = replace-with-login-token
@workspaceId = replace-with-workspace-uuid
@serviceId = replace-with-service-id
@serviceKey = replace-with-service-key
@environmentId = replace-with-environment-uuid
@ownerId = replace-with-owner-uuid
@resetToken = replace-with-reset-token
@activationToken = replace-with-activation-token
@recaptchaToken = replace-with-recaptcha-v3-token
@emailJobId = replace-with-email-job-uuid

### Login
# @name login
POST {{host}}/api/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "replace-with-password"
}

### Password reset captcha legacy endpoint
POST {{host}}/api/password-reset/captcha

### Request password reset
POST {{host}}/api/password-reset/request
Content-Type: application/json

{
  "email": "admin@example.com",
  "recaptcha_token": "{{recaptchaToken}}"
}

### Validate password reset token
# Reset tokens come from delivered OneSignal email, or local disabled-mode logs, not API responses.
POST {{host}}/api/password-reset/validate
Content-Type: application/json

{
  "token": "{{resetToken}}"
}

### Complete password reset
POST {{host}}/api/password-reset
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "password": "new-password",
  "confirm_password": "new-password"
}

### Registration captcha legacy endpoint
POST {{host}}/api/register/captcha

### Register account
POST {{host}}/api/register
Content-Type: application/json

{
  "email": "new-user@example.com",
  "nickname": "new-user",
  "password": "new-password",
  "confirm_password": "new-password",
  "recaptcha_token": "{{recaptchaToken}}"
}

### Register invited account
POST {{host}}/api/register
Content-Type: application/json

{
  "email": "invited@example.com",
  "nickname": "invited-user",
  "password": "new-password",
  "confirm_password": "new-password",
  "recaptcha_token": "{{recaptchaToken}}",
  "invitation_code": "{{workspaceInvitationCode}}"
}

### Google auth register or login
# Requires GOOGLE_AUTH_CLIENT_ID on the server. For the browser popup callback
# flow, the app sets a same-origin g_csrf_token cookie and sends the same value
# in the JSON body.
POST {{host}}/api/google-auth
Content-Type: application/json
Cookie: g_csrf_token={{googleCsrfToken}}

{
  "credential": "{{googleCredentialIdToken}}",
  "g_csrf_token": "{{googleCsrfToken}}",
  "invitation_code": "{{workspaceInvitationCode}}"
}

### Validate account activation token
# Activation tokens come from delivered OneSignal email, or local disabled-mode logs, not API responses.
POST {{host}}/api/account-activation/validate
Content-Type: application/json

{
  "token": "{{activationToken}}"
}

### Activate account
POST {{host}}/api/account-activation
Content-Type: application/json

{
  "token": "{{activationToken}}"
}

### Current user
GET {{host}}/api/me
Authorization: Bearer {{token}}

### Renew bearer token
POST {{host}}/api/renew
Authorization: Bearer {{token}}

### Logout
POST {{host}}/api/logout
Authorization: Bearer {{token}}

### App info
GET {{host}}/api/app-info

### List service availability
GET {{host}}/api/services
Authorization: Bearer {{token}}

### Claim a service environment
POST {{host}}/api/claim
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "service_key": "{{serviceKey}}",
  "claimed_by_label": "",
  "claimed_by_team": false
}

### Release a service environment
POST {{host}}/api/release
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "service_key": "{{serviceKey}}"
}

### Extend a service environment
POST {{host}}/api/extend
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "service_key": "{{serviceKey}}"
}

### List workspaces
GET {{host}}/api/workspaces
Authorization: Bearer {{token}}

### Create workspace
POST {{host}}/api/workspaces
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Example workspace"
}

### List workspace services
GET {{host}}/api/workspaces/{{workspaceId}}/services
Authorization: Bearer {{token}}

### Create workspace service
POST {{host}}/api/workspaces/{{workspaceId}}/services
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "label": "Example service",
  "default_minutes": 60,
  "owner_id": "{{ownerId}}",
  "environment_ids": ["{{environmentId}}"],
  "environment_names": []
}

### Update workspace service
PATCH {{host}}/api/workspaces/{{workspaceId}}/services/{{serviceId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "label": "Example service",
  "default_minutes": 90,
  "owner_id": "{{ownerId}}",
  "environment_ids": ["{{environmentId}}"],
  "environment_names": []
}

### Delete workspace service
DELETE {{host}}/api/workspaces/{{workspaceId}}/services/{{serviceId}}
Authorization: Bearer {{token}}

### List workspace environments
GET {{host}}/api/workspaces/{{workspaceId}}/environments
Authorization: Bearer {{token}}

### Create workspace environment
POST {{host}}/api/workspaces/{{workspaceId}}/environments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "staging"
}

### Delete workspace environment
DELETE {{host}}/api/workspaces/{{workspaceId}}/environments/{{environmentId}}
Authorization: Bearer {{token}}

### List workspace owners
GET {{host}}/api/workspaces/{{workspaceId}}/owners
Authorization: Bearer {{token}}

### Create workspace owner
POST {{host}}/api/workspaces/{{workspaceId}}/owners
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Platform"
}

### Delete workspace owner
DELETE {{host}}/api/workspaces/{{workspaceId}}/owners/{{ownerId}}
Authorization: Bearer {{token}}

### Workspace detail rows: users
GET {{host}}/api/workspaces/{{workspaceId}}/detail/users
Authorization: Bearer {{token}}

### Workspace detail rows: services
GET {{host}}/api/workspaces/{{workspaceId}}/detail/services
Authorization: Bearer {{token}}

### Workspace detail rows: owners
GET {{host}}/api/workspaces/{{workspaceId}}/detail/owners
Authorization: Bearer {{token}}

### Workspace detail rows: environments
GET {{host}}/api/workspaces/{{workspaceId}}/detail/environments
Authorization: Bearer {{token}}

### Invite user to workspace
POST {{host}}/api/workspaces/{{workspaceId}}/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "user@example.com"
}

### Invite unregistered email to workspace
POST {{host}}/api/workspaces/{{workspaceId}}/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "invited@example.com"
}

### Validate workspace invitation link
# Invitation codes come from delivered OneSignal email, or local disabled-mode logs, not API responses.
GET {{host}}/api/workspace-invitations/{{workspaceInvitationCode}}/validate

### Accept existing-user workspace invitation
POST {{host}}/api/workspace-invitations/{{workspaceInvitationCode}}/accept
Authorization: Bearer {{token}}

### Reinvite expired workspace invitation email
POST {{host}}/api/workspaces/{{workspaceId}}/invitations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "expired-invite@example.com"
}

### Remove pending workspace invitation
DELETE {{host}}/api/workspaces/{{workspaceId}}/invitations/{{workspaceInvitationId}}
Authorization: Bearer {{token}}

### Requeue failed transactional email jobs
POST {{host}}/api/email-jobs/failed/retry
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email_kind": "password_reset",
  "job_ids": ["{{emailJobId}}"]
}

### List workspace users for administration
GET {{host}}/api/workspaces/{{workspaceId}}/users
Authorization: Bearer {{token}}

### Update workspace user role
# The current workspace owner cannot demote their own membership.
PATCH {{host}}/api/workspaces/{{workspaceId}}/users/{{userId}}/role
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "manager"
}

### Remove workspace user
# The current workspace owner cannot remove their own membership.
DELETE {{host}}/api/workspaces/{{workspaceId}}/users/{{userId}}
Authorization: Bearer {{token}}
